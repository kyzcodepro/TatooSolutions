{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/b/:slug", "destination": "/book.html" },
    { "source": "/q/:token", "destination": "/quote.html" }
  ]
}
