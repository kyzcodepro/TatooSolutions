{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/cron/dispatch", "schedule": "0 8 * * *" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/b/:slug", "destination": "/book.html" },
    { "source": "/q/:token", "destination": "/quote.html" },
    { "source": "/join/:token", "destination": "/join.html" },
    { "source": "/s/:slug", "destination": "/studio.html" },
    { "source": "/api/(.*)", "destination": "/api/index?__path=/api/$1" }
  ]
}
